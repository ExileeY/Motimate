# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# Xcode build artifacts and user state
# (the .xcodeproj itself IS tracked — it's regenerable via `xcodegen generate`)
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Signing secrets — never commit
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# macOS
.DS_Store

# local env files
.env*.local
